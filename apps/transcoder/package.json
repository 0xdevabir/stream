{
  "name": "@stream/transcoder",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@stream/shared": "workspace:*",
    "ioredis": "^5.7.0",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@stream/config": "workspace:*",
    "@types/node": "^24.3.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

